# Supabase Postgres (pooled, port 6543)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Direct connection for migrations (port 5432)
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Resend
RESEND_API_KEY=re_xxx_replace_with_your_key
EMAIL_FROM="SF Apt Finder <apts@your-verified-domain.com>"
EMAIL_TO=viraat.laldas@gmail.com,sambruns2000@gmail.com

# Cron secret (random string; Vercel sends it as Bearer)
CRON_SECRET=set-a-long-random-string-here

# Optional: Anthropic Claude API key for LLM-based contact info extraction
# (without it, falls back to regex-only: still finds phone numbers and emails
# in listing descriptions, just won't extract contact names)
ANTHROPIC_API_KEY=

# Optional: Apify token for sites that block direct scraping
# (Apartments.com, Trulia, Padmapper, Hotpads, Zumper, Facebook, californiaapartments)
APIFY_TOKEN=

# Search criteria
SEARCH_BEDROOMS=3
SEARCH_MAX_PRICE=9000
SEARCH_CITY=san-francisco
